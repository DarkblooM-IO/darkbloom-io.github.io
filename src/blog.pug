---
title: Blog
layout: "base.pug"
---
div.container
  div.row
    div.col
      div.card
        div.card-header: h5.m-0 #[i.fa-solid.fa-file-lines] Blog posts 
        ul.list-group.list-group-flush: each post in collections.blog.slice().reverse()
          li.list-group-item: a(href=post.url)= post.data.title
