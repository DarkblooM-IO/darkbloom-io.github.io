---
title: Home
layout: "base.pug"
---
include _includes/_mixins.pug
div.row
  section.col-md.mb-3
    +sectionTitle("About me", "user")
    div.card: div.row.card-body
        div.col-md.mb-3
          h4.card-title Hi there!
          p.card-text I'm DarkblooM #[+badge("pronouns") any/all].#[br]I'm a 23 year old computer science student from France.
          p.card-text My main interests include:
          ul: each elem in ["computers", "gaming", "food", "music", "motorcycles"]
            li= elem
          div.card
            div.card-header.text-center My links
            div.card-body.text-center.row
              div
                a.card-link(href="https://darkblo0m.bsky.social"): i.fa-xl.fa-brands.fa-bluesky
                a.card-link(href="https://threads.com/@darkbloom.io"): i.fa-xl.fab.fa-threads
                a.card-link(href="https://youtube.com/@darkbloom_io"): i.fa-xl.fab.fa-youtube
              div.mt-3
                a.card-link(href="https://reddit.com/u/darkbloom_sr"): i.fa-xl.fab.fa-reddit
                a.card-link(href="https://tiktok.com/@darkbloom.io"): i.fa-xl.fab.fa-tiktok
                a.card-link(href="https://github.com/darkbloom-io"): i.fa-xl.fab.fa-github
        div.col-md
          div.card.text-bg-dark: img.card-img(src="/img/pfp.png")
          sup Profile picture by #[a(href="https://linktr.ee/offkair") OFFKAiR]
  section.col-md.mb-3
    +sectionTitle("My projects", "code")
    ul.fs-3
      li This website #[a(href="https://github.com/DarkblooM-IO/darkbloom-io.github.io"): i.fab.fa-github]
      li Windowed UI #[a(href="https://codepen.io/DarkblooM_IO/pen/MYjpjmd"): i.fab.fa-codepen]
      li My Linux dotfiles #[a(href="https://github.com/DarkblooM-IO/dotfiles"): i.fab.fa-github]
      li Bloomlang, an esoteric programming language #[a(href="https://github.com/DarkblooM-IO/bloomlang"): i.fab.fa-github]
      li #[a(href="https://strudel.cc/") Strudel] music #[a(href="https://github.com/DarkblooM-IO/strudel"): i.fab.fa-github]
      li Other stuff #[a(href="https://github.com/DarkblooM-IO/stuff"): i.fab.fa-github]
