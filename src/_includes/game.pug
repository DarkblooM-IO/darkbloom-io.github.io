doctype html
html(lang="en")
  head
    include _head.pug
    title #{title} · Games · DarkblooM
  body.vh-100.d-flex.flex-column.justify-content-center.align-items-center
    noscript
      style.
        main, #smallScreen { display: none !important; }
      h3 This game requires JavaScript
    a.btn.btn-secondary.position-absolute.top-0.start-0.m-2(href="/") #[i.fas.fa-arrow-left] Back to homepage
    main.d-none.d-md-block
      h1.lead.mb-3= title
      | !{content}
    div#smallScreen.d-md-none.vh-100.d-flex: h1.m-auto Please use a larger screen
    if gameid
      script(src=`/js/games/${gameid}.js` type="text/javascript")
