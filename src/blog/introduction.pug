mixin question(q)
  div.card.my-3
    div.card-header: strong #[i.fa-solid.fa-message] #{q}
    div.card-body
      block

.row
  .col-lg.mb-3
    :markdown-it
      ## About me

      If you don't know me, hi! I'm DarkblooM.  
    p I'm a #[span#age] year old computer science student from France.
    :markdown-it
      My pronouns are... uh... all of them. I really don't care.
      
      My main points of interest are:

      - computer science
      - gaming
      - music
      - motorcycles
    div
      img.img-fluid.rounded.w-auto(src="/img/pfp.png" alt="DarkblooM profile picture")
      br
      sup.text-end.text-muted Profile picture by #[a(href="https://linktr.ee/offkair") OFFKAiR]
  .col-lg
    h2 Q&A
    +question("How did you build this website?"): p.card-text.
      I use #[a(href="https://11ty.dev/") Build Awesome] (formerly 11ty) to generate the whole site statically, with #[a(href="https://pugjs.org/") Pug] for building templates, as well as #[a(href="https://getbootstrap.com/") Bootstrap] for UI and #[a(href="https://fontawesome.com/") Font Awesome] for icons.
    +question("Can I see the source code anywhere?"): p.card-text.
      Yes, you can check out the GitHub repo #[a(href="https://github.com/DarkblooM-IO/darkbloom-io.github.io") here].
    +question("Where can I follow you?")
      a.card-link(href="https://bsky.app/profile/darkblo0m.bsky.social" data-bs-toggle="tooltip" data-bs-title="Bluesky" style="--bs-link-hover-color-rgb: 17,133,254;"): i.fab.fa-bluesky.fa-xl
      a.card-link(href="https://threads.com/@darkbloom.io" data-bs-toggle="tooltip" data-bs-title="Threads" style="--bs-link-hover-color-rgb: 0,0,0;"): i.fab.fa-threads.fa-xl
      a.card-link(href="https://youtube.com/@darkbloom_io" data-bs-toggle="tooltip" data-bs-title="YouTube" style="--bs-link-hover-color-rgb: 255,0,0;"): i.fab.fa-youtube.fa-xl
      a.card-link(href="https://reddit.com/u/darkbloom_sr" data-bs-toggle="tooltip" data-bs-title="Reddit" style="--bs-link-hover-color-rgb: 255,69,0;"): i.fab.fa-reddit.fa-xl
      a.card-link(href="https://tiktok.com/@darkbloom.io" data-bs-toggle="tooltip" data-bs-title="TikTok" style="--bs-link-hover-color-rgb: 0,0,0;"): i.fab.fa-tiktok.fa-xl
      a.card-link(href="https://github.com/darkbloom-io" data-bs-toggle="tooltip" data-bs-title="GitHub" style="--bs-link-hover-color-rgb: 24,23,23;"): i.fab.fa-github.fa-xl
script.
  const birthDate = new Date('2002-07-07')
  const today = new Date()
  let age = today.getFullYear() - birthDate.getFullYear()
  const monthDiff = today.getMonth() - birthDate.getMonth()
  if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) age--
  document.querySelector("span#age").innerText = age
